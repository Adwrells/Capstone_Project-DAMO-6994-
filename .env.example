# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
#
# Read by docker-compose.yml (both services) and, for local (non-Docker) runs, by
# backend/config/settings.py / dotenv in server.ts directly.

# ─── Auth (backend/config/settings.py) ──────────────────────────────────────
# Single seeded account — this platform has no self-registration, see README.md#authentication.
# The "changeme" default only exists so the app runs with zero setup for local dev; never
# leave it as-is anywhere reachable outside your own machine.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# Signs JWTs. Falls back to a random per-process value if unset (fine for local dev — every
# restart just invalidates outstanding tokens — not fine for a real deployment, where you want
# tokens to survive a redeploy). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ─── CORS (backend/main.py) ──────────────────────────────────────────────────
# Comma-separated origins allowed to call the FastAPI backend. Defaults to localhost/127.0.0.1
# if unset — set this to your real domain(s) once deployed, e.g.:
#   CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=

# ─── AI assistance (server.ts) ───────────────────────────────────────────────
# Optional. Gemini-powered features (smart query, chart builder, dataset analysis) fall back
# to deterministic heuristics with no key set — the app runs fine without this.
GEMINI_API_KEY=
