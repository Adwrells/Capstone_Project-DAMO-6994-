# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ─── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/*.log
logs/*.txt
logs/**/*.log
*.log

# ─── Data & Outputs (raw / processed) ───────────────────────────────────────
data/raw/
data/processed/
*.csv
*.xlsx
*.xls
output/

# ─── Testing & Coverage ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ─── IDE / Editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── OS ──────────────────────────────────────────────────────────────────────
desktop.ini
